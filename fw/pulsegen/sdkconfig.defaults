# Heltec WiFi LoRa 32 V3 is ESP32-S3 based.
# (Target is normally selected with `idf.py set-target esp32s3`, which writes
#  CONFIG_IDF_TARGET into sdkconfig; this file just holds project defaults.)

# Keep the default 160 MHz CPU; MCPWM gets its clock from PLL160M regardless.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
